<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <proxyConfiguration>
    <port>8888</port>
    <decryptSSL>true</decryptSSL>
    <sslLocations><locationPatterns/></sslLocations>
  </proxyConfiguration>
  <tools>
    <entry><string>Map Remote</string><map><toolEnabled>false</toolEnabled><mappings/></map></entry>
  </tools>
</configuration>
